# ============================================
# AI Image Editor - Environment Configuration
# ============================================

# ========================================
# ORCHESTRATOR (Required for /chat endpoint)
# ========================================
# Choose: "openai" (recommended - cheaper/faster) or "claude" (premium quality)
ORCHESTRATOR_TYPE=openai

# ========================================
# API KEYS (Add at least one provider + orchestrator)
# ========================================

# OpenAI (for DALL-E provider AND/OR orchestrator)
# Get key: https://platform.openai.com/api-keys
# Used for: DALL-E image generation + GPT-4o-mini orchestrator
OPENAI_API_KEY=your_openai_api_key_here

# Claude (for orchestrator only - optional alternative)
# Get key: https://console.anthropic.com/
# Used for: Premium Claude 3.5 Sonnet orchestrator
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Recraft AI (image provider)
# Get key: https://www.recraft.ai/profile/api
# Features: generate, upscale, remove/replace background, vectorize
RECRAFT_API_KEY=your_recraft_api_key_here
RECRAFT_URL=https://external.api.recraft.ai/v1

# Replicate (for Flux, SDXL, etc.)
# Get key: https://replicate.com/account/api-tokens
# Features: generate, upscale, edit (highest quality models)
REPLICATE_API_KEY=your_replicate_api_key_here

# ⭐ Gemini API (RECOMMENDED - same as Google AI Studio)
# Get key: https://aistudio.google.com/app/apikey
# Features: generate, edit, image-to-image (BEST quality, same as Studio!)
# This is "Nano Banana Pro" / gemini-2.0-flash-exp from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# ⚠️ DEPRECATED: Google Vertex AI Imagen (use Gemini above instead)
# Get setup: https://cloud.google.com/vertex-ai/docs/start/cloud-environment
# Features: generate, edit, upscale, inpainting (lower quality than Gemini)
# Note: This is NOT the same as Google AI Studio's models
GOOGLE_PROJECT_ID=your_google_cloud_project_id
GOOGLE_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ========================================
# APPLICATION SETTINGS
# ========================================
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================================
# OPTIONAL SETTINGS
# ========================================
# Local image storage path (leave empty to skip local storage)
IMAGE_STORAGE_PATH=./generated_images

# Default provider when none specified
DEFAULT_PROVIDER=recraft

# Provider preferences (comma-separated, in order of preference)
PREFERRED_GENERATE_PROVIDERS=gemini,recraft,openai,replicate
PREFERRED_UPSCALE_PROVIDERS=recraft,gemini,replicate
PREFERRED_EDIT_PROVIDERS=gemini,recraft,openai,replicate


